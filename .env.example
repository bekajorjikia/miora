# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Service role — local seed script only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: allow local seed menu when Supabase is down/empty.
# In production this defaults to off (fail closed). Set true only for emergencies.
# ALLOW_SEED_FALLBACK=true
